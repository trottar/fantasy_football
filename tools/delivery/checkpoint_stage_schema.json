{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fantasy Football Generic Checkpoint Staging Spec",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint_id",
    "repo",
    "branch",
    "expected_remote_head",
    "project_root",
    "stage_root",
    "source_paths",
    "exact_sha256",
    "semantic_markers",
    "manifest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "expected_remote_head": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "stage_root": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exact_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
      }
    },
    "semantic_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "contains"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "contains": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "root",
        "path"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "durable_memory_updated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
